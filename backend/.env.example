NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Production (Neon via Vercel Marketplace) sets DATABASE_URL; it wins over DATABASE_*.
DATABASE_URL=postgres://droneviet:droneviet@localhost:5433/droneviet
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=droneviet
DATABASE_USER=droneviet
DATABASE_PASSWORD=droneviet
CRON_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
# Local/development defaults only. Set unique credentials in production.
SEED_ADMIN_EMAIL=admin@droneviet.vn
SEED_ADMIN_PASSWORD=admin123
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/thanh-toan/thanh-cong
PAYOS_CANCEL_URL=http://localhost:3000/thanh-toan/huy
VIETTELPOST_API_URL=
VIETTELPOST_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Social sign-in (OAuth). Callbacks: ${PUBLIC_API_URL}/auth/google/callback and /auth/zalo/callback
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=https://www.droneviet.vn/auth/zalo/callback
# Zalo returns personal info only to Vietnam IPs: fetch the profile through infra/zalo-relay (justin)
ZALO_PROFILE_RELAY_URL=
ZALO_PROFILE_RELAY_SECRET=
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
# Media on Cloudflare R2 (unset outside production = in-memory storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=droneviet-media
# R&D publishing skill token (Bearer) for /admin/content/articles and /admin/media
CONTENT_PUBLISH_TOKEN=
# Session cookie domain shared by www and api (production only)
COOKIE_DOMAIN=
# Integration tests use their own database (create once: CREATE DATABASE droneviet_test)
# TEST_DATABASE_URL=postgres://droneviet:droneviet@localhost:5433/droneviet_test
